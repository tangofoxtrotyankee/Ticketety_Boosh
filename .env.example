# --- Database (Neon) ---
# Pooled connection string (pgbouncer endpoint) — used by the app at runtime
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-west-2.aws.neon.tech/tfy_tickets?sslmode=require"
# Direct (non-pooled) connection string — used by Prisma migrations only
DIRECT_URL="postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/tfy_tickets?sslmode=require"

# --- Auth.js ---
# Canonical URL of the deployment (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- Email (Resend) ---
# Verified sender, e.g. "TFY Tickets <tickets@yourdomain.com>"
EMAIL_FROM="TFY Tickets <tickets@example.com>"
RESEND_API_KEY=""

# --- Stripe ---
# Use test keys locally (sk_test_/pk_test_), live keys only in production
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Rate limiting (optional) ---
# If both are set, Upstash Redis is used; otherwise a Postgres-backed limiter is used
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Cron ---
# Shared secret for /api/cron/expire-orders (Authorization: Bearer <CRON_SECRET>)
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- App ---
# Public origin used in links/emails (usually same as NEXTAUTH_URL)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
